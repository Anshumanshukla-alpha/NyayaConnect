# Local/demo configuration only. Production must set APP_ENV=production and verified DB TLS.
APP_ENV=local

# Frontend uses the same-origin API by default.
# In local development Vite proxies /api, /health and /ready to Tomcat.
VITE_API_BASE_URL=""

# Backend secrets belong on the server only; never expose them as VITE_* variables.
# DB_URL=jdbc:mysql://localhost:3306/nyayaconnect
# DB_USER=nyaya_app
# DB_PASSWORD=change-me

# Docker local/demo defaults. Use a secret manager or Docker secrets in production.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=nyaya_app
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://mysql:3306/nyayaconnect?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC # local Docker demo only
